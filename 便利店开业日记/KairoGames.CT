loop:
mov ebx,[eax]
cmp ebx,0
je next
cmp [ebx+4C],4
je next

mov ebx,[ebx+8]

mov ecx,[esi+EC]
lea ecx,[ecx+10+ebx*1]
mov byte ptr [ecx],1

mov ecx,[esi+E8]
lea ecx,[ecx+10+ebx*4]
mov [ecx],#99

next:
add eax,4
dec edi
jne loop
end:
ret
createthread(mycode)
 
