<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="34">
  <CheatEntries>
    <CheatEntry>
      <ID>34</ID>
      <Description>"一键拉满各种物品"</Description>
      <Options moAlwaysHideChildren="1"/>
      <LastState/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(code, 1024)
alloc(offsetlist, 64)

offsetlist:
dd 18 1C 34 68 9C BC

code:
push ebp
mov ebp, offsetlist
outerloop:
mov edx, [ebp]
test edx, edx
jz end
add ebp, 4
mov eax, [GameAssembly.dll+DC04A0]
mov eax, [eax+5C]
mov eax, [eax]
mov eax, [eax+edx]
mov edi, [eax+C]
loopb:
mov ebx, [eax+10]
cmp ebx, 0
je next
lea ebx, [ebx+10]
pushad
push 0
push #90
push ebx
call GameAssembly.dll+8A9820
add esp, C
popad
next:
add eax, 4
dec edi
jne loopb
jmp outerloop
end:
pop ebp
ret

createthread(code)

[DISABLE]
dealloc(code)
dealloc(offset_list)
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
